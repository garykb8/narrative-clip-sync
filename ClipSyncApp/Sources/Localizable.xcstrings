    "All camera photos are backed up": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機照片都已備份"
          }
        }
      }
    },
    "Also synced %lld new photos; deleted %lld verified files from the camera.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "另外同步了 %1$lld 張新照片；共從相機刪除 %2$lld 個已驗證的檔案。"
          }
        }
      }
    },
    "Ask after syncing (recommended)": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步後詢問我（建議）"
