    "Deleted %lld verified files from the camera.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從相機刪除了 %lld 個已驗證的檔案。"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Deleted %lld verified file from the camera."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Deleted %lld verified files from the camera."
                }
              }
            }
          }
        }
      }
    },
    "Each file is compared byte for byte with the copy on your Mac once more before it's deleted.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除前會再逐 byte 比對一次 Mac 上的備份。"
          }
        }
      }
    },
    "General": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一般"
          }
        }
      }
    },
    "Last synced %@ · %lld new": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上次同步：%1$@，新增 %2$lld 張照片"
          }
        }
      }
    },
    "Library": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
