              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld photos"
                }
              }
            }
          }
        }
      }
    },
    "%lld photos on the camera are safely backed up to your Mac and can be cleared.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相機上有 %lld 張照片已安全備份到 Mac，可以清除。"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld photo on the camera is safely backed up to your Mac and can be cleared."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld photos on the camera are safely backed up to your Mac and can be cleared."
                }
              }
            }
          }
        }
      }
    },
    "(%lld of %lld)": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "（%1$lld / %2$lld）"
          }
        }
