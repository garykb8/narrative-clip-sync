    "Move %lld Photos to Trash": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 %lld 張照片移到垃圾桶"
          }
        }
      }
    },
    "Move the selected photos and their .json and .snap files to the Trash (⌘⌫)": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將選取的照片和對應的 .json、.snap 一起移到垃圾桶（⌘⌫）"
          }
        }
      }
    },
    "Move to Trash": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移到垃圾桶"
          }
        }
      }
    },
    "Narrative Clip": {
      "shouldTranslate": false
    },
    "Never": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永不清除"
          }
        }
      }
    },
    "No Photos Yet": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒有照片"
          }
        }
      }
    },
    "No new photos": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有新的照片"
          }
        }
      }
    },
    "Not Connected": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未連接"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "Only photos that are on your Mac and match byte for byte are deleted. The camera holds about 8 GB, roughly a week of daily wear.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會刪除已經在 Mac 上、而且逐 byte 比對一致的照片。相機約 8GB，每天配戴約一週會存滿。"
          }
        }
      }
    },
    "Open at Login": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入時自動啟動"
          }
        }
      }
    },
    "Open in Finder": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Finder 中打開"
          }
        }
      }
    },
    "Photos appear here after you connect your Narrative Clip.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接上 Narrative Clip 後，照片會出現在這裡。"
          }
        }
      }
    },
    "Photos go in “Photos”, named by shot time and rotated upright; each photo’s .json and .snap files go in “Metadata”. Deleting a photo in Narrative Clip Sync moves those to the Trash too.": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片放在「Photos」，依拍攝時間命名並已轉正；每張照片的 .json、.snap 收在「Metadata」。在 Narrative Clip Sync 裡刪除照片時會一併移到垃圾桶。"
          }
        }
      }
    },
    "Preparing to transfer %lld photos": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "準備傳輸 %lld 張照片"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Preparing to transfer %lld photo"
                }
