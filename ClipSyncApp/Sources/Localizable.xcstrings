{
  "sourceLanguage": "en",
  "strings": {
    "%lld": {
      "shouldTranslate": false
    },
    "%lld files didn't match and were kept on the camera": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個檔案比對不符，已保留在相機上"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld file didn't match and was kept on the camera"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld files didn't match and were kept on the camera"
                }
              }
            }
          }
        }
      }
    },
    "%lld of %lld selected": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已選取 %1$lld / %2$lld 張"
          }
        }
      }
    },
    "%lld photos": {
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 張"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld photo"
